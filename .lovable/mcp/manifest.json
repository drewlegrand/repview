                "Open",
                "Closed Won",
                "Closed Lost"
              ]
            },
            "manufacturer_line": {
              "description": "Manufacturer line name.",
              "type": "string"
            },
            "owner": {
              "description": "Opportunity owner / rep name.",
              "type": "string"
            },
            "min_value": {
              "description": "Only return opportunities worth at least this amount.",
              "type": "number"
            },
            "limit": {
              "description": "Max rows to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
