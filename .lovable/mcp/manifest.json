      {
        "name": "pipeline_summary",
        "title": "Pipeline summary",
        "description": "Return headline CRM metrics: pipeline value by stage, revenue by manufacturer line, forecast by rep, and dashboard totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_accounts",
        "title": "List accounts",
        "description": "List CRM accounts (architects, contractors, owners, distributors) with optional filtering by name, type, or territory.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Case-insensitive match on account name or city.",
              "type": "string"
            },
            "type": {
              "description": "Account type, e.g. Architect, General Contractor, Distributor.",
              "type": "string"
            },
            "territory": {
              "description": "Sales territory name.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_contacts",
        "title": "List contacts",
        "description": "List CRM contacts, optionally filtered by name, account name, or influence level.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Case-insensitive match on contact name, title, or email.",
              "type": "string"
            },
            "account_name": {
              "description": "Filter to contacts at this account.",
              "type": "string"
            },
            "influence_level": {
              "type": "string",
              "enum": [
                "High",
                "Medium",
                "Low"
              ]
            },
            "limit": {
              "description": "Max rows to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_opportunities",
